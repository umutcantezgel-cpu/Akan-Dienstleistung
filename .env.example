# ═══════════════════════════════════════════════════════════
# AKAN Dienstleistung — Environment Variables
# ═══════════════════════════════════════════════════════════

# Canonical Site URL (Production)
NEXT_PUBLIC_SITE_URL="https://akan-dienstleistung.de"

# Contact Form & E-Mail Dispatch (Resend API)
# Get your API key from https://resend.com
RESEND_API_KEY=""

# Contact Form Recipient (Default: info@akan-dienstleistung.de)
CONTACT_EMAIL_RECIPIENT="info@akan-dienstleistung.de"

# Verified Sender Address in Resend
CONTACT_EMAIL_FROM="AKAN Dienstleistung <noreply@akan-dienstleistung.de>"

# Optional: Webhook URL (Zapier, Make, Slack, Discord or CRM)
# CONTACT_WEBHOOK_URL="https://your-webhook-endpoint.example.com"

# Optional: Bundle Analyzer (true/false)
ANALYZE="false"
